import FreeCAD as App
import FreeCADGui as Gui

doc=App.ActiveDocument
plan=doc.getObject("PlanReview")
if plan is None:
    raise RuntimeError("Open the regenerated Home.FCStd model first.")
show_plan=not plan.ViewObject.Visibility
for name in ("Walls","Openings","Roof"):
    doc.getObject(name).ViewObject.Visibility=not show_plan
plan.ViewObject.Visibility=show_plan
if show_plan:
    Gui.activeDocument().activeView().viewTop()
else:
    for obj in doc.getObject("Openings").Group:
        if obj.Label.startswith("Hall to dining"):
            obj.ViewObject.Visibility=False
    Gui.activeDocument().activeView().viewAxonometric()
Gui.activeDocument().activeView().fitAll()
